@model List<CyberWalletWeb.Models.Income>
@{
    ViewData["Title"] = "Income";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Income</h2>

    <a href="/Income/Create"
       class="btn btn-success">

       Add Income

    </a>
</div>

<div class="card shadow-sm p-4">

    <table class="table">

        <thead>
            <tr>
                <th>Source</th>
                <th>Amount</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var income in Model)
            {
                <tr>
                    <td>@income.Source</td>
                    <td>R @income.Amount</td>
                    <td>@income.Date.ToShortDateString()</td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@income.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@income.Id"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>