@model CyberWalletWeb.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Financial Dashboard</h2>

<div class="row g-4">

    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Current Balance</h6>
                <h3 class="fw-bold text-success">
                    R @Model.TotalBalance
                </h3>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Total Income</h6>
                <h3 class="fw-bold text-primary">
                    R @Model.TotalIncome
                </h3>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Total Expenses</h6>
                <h3 class="fw-bold text-danger">
                    R @Model.TotalExpenses
                </h3>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Active Budgets</h6>
                <h3 class="fw-bold text-warning">
                    @Model.BudgetCount
                </h3>
            </div>
        </div>
    </div>

</div>

<div class="row g-4 mt-1">

    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Expense Records</h6>
                <h3 class="fw-bold text-warning">
                    @Model.ExpenseCount
                </h3>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Income Records</h6>
                <h3 class="fw-bold text-info">
                    @Model.IncomeCount
                </h3>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Transactions</h6>
                <h3 class="fw-bold text-dark">
                    @Model.TransactionCount
                </h3>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Savings Goal</h6>
                <h3 class="fw-bold text-success">
                    R5,000
                </h3>
            </div>
        </div>
    </div>

</div>

<div class="row mt-4">

    <div class="col-lg-7">

        <div class="card shadow-sm">

            <div class="card-header">
                Expense Breakdown
            </div>

            <div class="card-body">

                <canvas id="expenseChart"></canvas>

            </div>

        </div>

    </div>

    <div class="col-lg-5">

        <div class="card shadow-sm">

            <div class="card-header">
                Monthly Budget
            </div>

            <div class="card-body">

                <div class="progress" style="height:25px;">

                    <div class="progress-bar"
                         role="progressbar"
                         style="width:70%;">

                        70%

                    </div>

                </div>

                <p class="mt-3 mb-0">
                    You have used 70% of your monthly budget.
                </p>

            </div>

        </div>

    </div>

</div>

<div class="row mt-4">

    <div class="col-12">

        <div class="card shadow-sm">

            <div class="card-header">
                Recent Transactions
            </div>

            <div class="card-body">

                <table class="table table-hover">

                    <thead>

                        <tr>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Date</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>Food</td>
                            <td>R250</td>
                            <td>27 May 2026</td>
                        </tr>

                        <tr>
                            <td>Transport</td>
                            <td>R120</td>
                            <td>26 May 2026</td>
                        </tr>

                        <tr>
                            <td>Shopping</td>
                            <td>R900</td>
                            <td>25 May 2026</td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        const labels = @Html.Raw(Model.ExpenseLabelsJson);

        const data = @Html.Raw(Model.ExpenseDataJson);

        new Chart(document.getElementById("expenseChart"), {

            type: "pie",

            data: {

                labels: labels,

                datasets: [{

                    data: data

                }]

            }

        });

    </script>
}