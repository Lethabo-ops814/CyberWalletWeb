@model CyberWalletWeb.Models.Category

@{
    ViewData["Title"] = "Add Category";
}

<h2 class="mb-4">Add Category</h2>

<form method="post">

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">
            Category Name
        </label>

        <input asp-for="Name"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Type
        </label>

        <select asp-for="Type"
                class="form-control">

            <option value="">
                Select Type
            </option>

            <option value="Expense">
                Expense
            </option>

            <option value="Income">
                Income
            </option>

        </select>
    </div>

    <button class="btn btn-primary">
        Save Category
    </button>

</form>