@model List<CyberWalletWeb.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Categories</h2>

    <a href="/Categories/Create"
       class="btn btn-primary">
        Add Category
    </a>

</div>

<div class="card shadow-sm p-4">

    <table class="table">

        <thead>
            <tr>
                <th>ID</th>
                <th>Category Name</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                    <td>@category.Type</td>
                

                <td>

                    <a asp-action="Edit"
                    asp-route-Id="@category.Id"
                    class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                    asp-route-Id="@category.Id"
                    class="btn btn-warning btn-sm">
                        Delete
                    </a>
                </td>
                </tr>
            }

        </tbody>

    </table>

</div>