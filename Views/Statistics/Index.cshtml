@model CyberWalletWeb.Models.StatisticsViewModel

@{
    ViewData["Title"] = "Statistics";
}

<h2 class="mb-4">Financial Statistics</h2>

<div class="row mb-4">

    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h6>Total Income</h6>
                <h3>R @Model.TotalIncome</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-danger text-white">
            <div class="card-body">
                <h6>Total Expenses</h6>
                <h3>R @Model.TotalExpenses</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h6>Balance</h6>
                <h3>R @Model.Balance</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-dark text-white">
            <div class="card-body">
                <h6>Transactions</h6>
                <h3>@Model.TransactionCount</h3>
            </div>
        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-6">

        <div class="card">

            <div class="card-header">
                Expense Breakdown
            </div>

            <table class="table table-striped mb-0">

                <thead>

                    <tr>
                        <th>Category</th>
                        <th class="text-end">Amount</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.ExpenseByCategory)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td class="text-end">
                                R @item.Value
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card">

            <div class="card-header">
                Income Breakdown
            </div>

            <table class="table table-striped mb-0">

                <thead>

                    <tr>
                        <th>Category</th>
                        <th class="text-end">Amount</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.IncomeByCategory)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td class="text-end">
                                R @item.Value
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>