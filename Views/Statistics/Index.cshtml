@model CyberWalletWeb.Models.StatisticsViewModel

@{
    ViewData["Title"] = "Statistics";
}

<h2 class="mb-4">Financial Statistics Dashboard</h2>

<div class="row mb-4">

    <div class="col-md-3">

        <div class="card bg-success text-white shadow-sm h-100">

            <div class="card-body">

                <h6>
                    <i class="bi bi-arrow-down-circle me-2"></i>
                    Total Income
                </h6>

                <h3>
                    R @Model.TotalIncome.ToString("N2")
                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card bg-danger text-white shadow-sm h-100">

            <div class="card-body">

                <h6>
                    <i class="bi bi-arrow-up-circle me-2"></i>
                    Total Expenses
                </h6>

                <h3>
                    R @Model.TotalExpenses.ToString("N2")
                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card bg-primary text-white shadow-sm h-100">

            <div class="card-body">

                <h6>
                    <i class="bi bi-wallet2 me-2"></i>
                    Balance
                </h6>

                <h3>
                    R @Model.Balance.ToString("N2")
                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card bg-dark text-white shadow-sm h-100">

            <div class="card-body">

                <h6>
                    <i class="bi bi-receipt me-2"></i>
                    Total Transactions
                </h6>

                <h3>
                    @Model.TransactionCount
                </h3>

            </div>

        </div>

    </div>

</div>

<div class="row mb-4">

    <div class="col-lg-6">

        <div class="card shadow-sm h-100">

            <div class="card-header fw-semibold">
                Expense Breakdown by Category
            </div>

            <div class="card-body p-0">

                <table class="table table-striped mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Category</th>

                            <th class="text-end">
                                Amount
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.ExpenseByCategory)
                        {
                            <tr>

                                <td>@item.Key</td>

                                <td class="text-end">

                                    R @item.Value.ToString("N2")

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <div class="col-lg-6">

        <div class="card shadow-sm h-100">

            <div class="card-header fw-semibold">
                Expense Breakdown Chart
            </div>

            <div class="card-body">

                <canvas id="expenseChart"></canvas>

            </div>

        </div>

    </div>

</div>

<div class="row mb-4">

    <div class="col-lg-6">

        <div class="card shadow-sm h-100">

            <div class="card-header fw-semibold">
                Income Breakdown by Source
            </div>

            <div class="card-body p-0">

                <table class="table table-striped mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Source</th>

                            <th class="text-end">
                                Amount
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.IncomeByCategory)
                        {
                            <tr>

                                <td>@item.Key</td>

                                <td class="text-end">

                                    R @item.Value.ToString("N2")

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <div class="col-lg-6">

        <div class="card shadow-sm h-100">

            <div class="card-header fw-semibold">
                Income Breakdown Chart
            </div>

            <div class="card-body">

                <canvas id="incomeChart"></canvas>

            </div>

        </div>

    </div>

</div>

<div class="row">

    <div class="col-12">

        <div class="card shadow-sm">

            <div class="card-header fw-semibold">
                Income vs Expenses Overview
            </div>

            <div class="card-body">

                <canvas id="comparisonChart"></canvas>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        const expenseLabels = @Html.Raw(Model.ExpenseLabelsJson);
        const expenseData = @Html.Raw(Model.ExpenseDataJson);

        new Chart(document.getElementById("expenseChart"), {

            type: "pie",

            data: {

                labels: expenseLabels,

                datasets: [{

                    label: "Expenses",

                    data: expenseData,

                    backgroundColor: [
                        "#dc3545",
                        "#fd7e14",
                        "#ffc107",
                        "#20c997",
                        "#0d6efd",
                        "#6f42c1",
                        "#198754"
                    ]

                }]

            }

        });

        const incomeLabels = @Html.Raw(Model.IncomeLabelsJson);
        const incomeData = @Html.Raw(Model.IncomeDataJson);

        new Chart(document.getElementById("incomeChart"), {

            type: "doughnut",

            data: {

                labels: incomeLabels,

                datasets: [{

                    label: "Income",

                    data: incomeData,

                    backgroundColor: [
                        "#198754",
                        "#20c997",
                        "#0dcaf0",
                        "#0d6efd",
                        "#6610f2",
                        "#6f42c1"
                    ]

                }]

            }

        });

        const comparisonLabels = @Html.Raw(Model.ComparisonLabelsJson);
        const comparisonData = @Html.Raw(Model.ComparisonDataJson);

        new Chart(document.getElementById("comparisonChart"), {

            type: "bar",

            data: {

                labels: comparisonLabels,

                datasets: [{

                    label: "Amount",

                    data: comparisonData,

                    backgroundColor: [
                        "#198754",
                        "#dc3545"
                    ],

                    borderRadius: 8

                }]

            },

            options: {

                responsive: true,

                plugins: {

                    legend: {

                        display: false

                    }

                }

            }

        });

    </script>
}